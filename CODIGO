void asignarCurso() {
    int a,c;
    cout<<"Alumno ID: "; cin>>a;
    cout<<"Curso ID: "; cin>>c;

    auto stmt = con->prepareStatement("INSERT INTO alumno_cursos(alumno_id,curso_id) VALUES(?,?)");
    stmt->setInt(1,a);
    stmt->setInt(2,c);
    stmt->execute();
}

void asignarSeccion() {
    int a,s;
    cin>>a>>s;

    auto stmt = con->prepareStatement("INSERT INTO alumno_seccion(alumno_id,seccion_id) VALUES(?,?)");
    stmt->setInt(1,a);
    stmt->setInt(2,s);
    stmt->execute();
}


void listadoCompleto() {
    auto res = con->createStatement()->executeQuery(
        "SELECT a.nombres, c.nombre AS curso, s.nombre AS seccion "
        "FROM alumnos a "
        "LEFT JOIN alumno_cursos ac ON a.id=ac.alumno_id "
        "LEFT JOIN cursos c ON ac.curso_id=c.id "
        "LEFT JOIN alumno_seccion ase ON a.id=ase.alumno_id "
        "LEFT JOIN secciones s ON ase.seccion_id=s.id"
    );

    while(res->next()){
        cout<<res->getString("nombres")<<" "
            <<res->getString("curso")<<" "
            <<res->getString("seccion")<<endl;
    }
}


void menuAlumnos() {
    int op;
    do{
        cout<<"\n1.Insertar 2.Listar 3.Actualizar 4.Eliminar 5.Regresar\n";
        cin>>op;
        if(op==1) insertarAlumno();
        if(op==2) listarAlumnos();
        if(op==3) actualizarAlumno();
        if(op==4) eliminarAlumno();
    }while(op!=5);
}

