#include <iostream>
#include <mysql_driver.h>
#include <mysql_connection.h>
#include <cppconn/statement.h>
#include <cppconn/prepared_statement.h>
#include <cppconn/resultset.h>

using namespace std;

sql::Connection *con;


void conectar() {
    sql::mysql::MySQL_Driver *driver;
    driver = sql::mysql::get_mysql_driver_instance();
    con = driver->connect("tcp://127.0.0.1:3306", "root", "123456");
    con->setSchema("universidad");
}


void insertarAlumno() {
    string n,a,c;
    cout<<"Nombres: "; cin>>n;
    cout<<"Apellidos: "; cin>>a;
    cout<<"Carnet: "; cin>>c;

    auto stmt = con->prepareStatement("INSERT INTO alumnos(nombres,apellidos,carnet) VALUES(?,?,?)");
    stmt->setString(1,n);
    stmt->setString(2,a);
    stmt->setString(3,c);
    stmt->execute();
}

void listarAlumnos() {
    auto stmt = con->createStatement();
    auto res = stmt->executeQuery("SELECT * FROM alumnos");

    while(res->next()){
        cout<<res->getInt("id")<<" "
            <<res->getString("nombres")<<" "
            <<res->getString("apellidos")<<" "
            <<res->getString("carnet")<<endl;
    }
}

void actualizarAlumno() {
    int id; string n;
    cout<<"ID: "; cin>>id;
    cout<<"Nuevo nombre: "; cin>>n;

    auto stmt = con->prepareStatement("UPDATE alumnos SET nombres=? WHERE id=?");
    stmt->setString(1,n);
    stmt->setInt(2,id);
    stmt->execute();
}

void eliminarAlumno() {
    int id; cout<<"ID: "; cin>>id;
    auto stmt = con->prepareStatement("DELETE FROM alumnos WHERE id=?");
    stmt->setInt(1,id);
    stmt->execute();
}

void insertarCurso() {
    string n,c;
    cout<<"Nombre: "; cin>>n;
    cout<<"Codigo: "; cin>>c;

    auto stmt = con->prepareStatement("INSERT INTO cursos(nombre,codigo) VALUES(?,?)");
    stmt->setString(1,n);
    stmt->setString(2,c);
    stmt->execute();
}

void listarCursos() {
    auto res = con->createStatement()->executeQuery("SELECT * FROM cursos");
    while(res->next()){
